# 可直接指定 CRM 私有配置文件；只读取 Odoo 配置，不修改原文件。
LIGHTHOUSE_CRM_ENV_FILE=
# 也支持 CRM 原有的 ODOO_BASE_URL / ODOO_DATABASE / ODOO_USERNAME。
# 以下旧看板名称若非空则优先使用。
ODOO_URL=
ODOO_DB=
ODOO_USER=
ODOO_PASSWORD=
ODOO_TIMEOUT_SECONDS=12
# 交付塔与灯塔共用以上只读连接。交付塔服务参数使用系统环境变量设置，见使用说明。
LIGHTHOUSE_HOST=127.0.0.1
LIGHTHOUSE_PORT=8780
LIGHTHOUSE_REFRESH_SECONDS=180
# 非本机监听必须设置访问口令；口令只在请求头传递，不放在 URL。
LIGHTHOUSE_TOKEN=
