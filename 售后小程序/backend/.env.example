# ===== 基础配置 =====
# 运行环境标识（用于 /health 展示；development / production）
ENV=development
APP_TITLE=After-sales Service API

# ===== JWT 安全配置 =====
# 可选：缺失时自动生成临时随机密钥（服务重启后所有令牌失效）。
# 生产环境务必配置固定密钥，生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
# HS256 / HS384 / HS512
JWT_ALGORITHM=HS256
# Token 有效期（分钟），默认 1440（1 天）
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 数据库 =====
# 默认 SQLite（无需额外配置）；生产建议使用 PostgreSQL：
DATABASE_URL=sqlite:///./aftersales.db
# DATABASE_URL=postgresql+psycopg2://aftersales:change-this-password@db:5432/aftersales

# ===== CORS / Web =====
CORS_ORIGINS=http://127.0.0.1:8001,http://localhost:8001
WEB_MOUNT_PATH=/web

# ===== 高德地图 Web 服务（定位解析）=====
# 不配置则 /api/locations/reverse-geocode 返回 503
AMAP_WEB_SERVICE_KEY=
AMAP_TIMEOUT_SECONDS=15

# ===== 文件上传安全 =====
# 单文件大小上限（MB），默认 10
UPLOAD_MAX_SIZE_MB=10
# public：/uploads 静态目录可直接访问（小程序 <image> 组件必需）
# protected：关闭静态目录，改为需登录态访问的 /api/files/{name} 下载接口（Web 端自动适配）
UPLOADS_ACCESS_MODE=public

# ===== 登录安全 =====
# 同一账号+IP 连续失败次数上限，超过后锁定
LOGIN_MAX_FAILURES=5
# 锁定分钟数
LOGIN_LOCK_MINUTES=15
# 启用 HTTPS 后设为 1，httpOnly Cookie 将带 Secure 标记
COOKIE_SECURE=0

# ===== Odoo ERP（客户数据源）=====
# 不配置则 /api/odoo/customers 返回 503，前端降级为手动输入客户信息
ODOO_URL=https://erp.example.com
ODOO_DB=your_database_name
ODOO_USERNAME=api_account
ODOO_PASSWORD=your_api_key
# 请求超时（秒）
ODOO_TIMEOUT_SECONDS=10
# 客户查询结果缓存时间（秒），避免频繁请求 Odoo
ODOO_CACHE_TTL_SECONDS=60
