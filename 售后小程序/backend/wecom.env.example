# Load alongside existing service.env, never replace existing service secrets.
WECOM_CORP_ID=replace_corp_id
WECOM_AGENT_ID=1000002
WECOM_APP_SECRET=replace_application_secret
# Default off. New events while off are SKIPPED and never automatically replayed.
WECOM_NOTIFICATIONS_ENABLED=0
# Keys are verified ASS users.id, NOT engineers.id, names, or WeChat openid.
WECOM_USER_BINDINGS={}
