.header-wrap {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: #1e80ff;
}

.header-bar {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 12px;
  position: relative;
}

.header-left {
  position: absolute;
  left: 16px;
  font-size: 15px;
  color: #fff;
  font-weight: 500;
}

.header-center {
  font-size: 17px;
  font-weight: 600;
  color: #fff;
}

.header-right {
  position: absolute;
  right: 16px;
  font-size: 12px;
  background: rgba(255,255,255,0.2);
  color: #fff;
  padding: 2px 10px;
  border-radius: 10px;
}
