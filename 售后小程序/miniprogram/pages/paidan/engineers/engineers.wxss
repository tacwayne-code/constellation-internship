.btn-add {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 24rpx;
  background: #1e80ff;
  color: #fff;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.4;
  white-space: nowrap;
}

.engineer-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  gap: 16rpx;
}

.engineer-item:last-child {
  border-bottom: none;
}

.eng-info {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.eng-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1d2129;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.eng-meta {
  font-size: 22rpx;
  color: #86909c;
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.eng-specialty {
  display: inline-block;
  font-size: 22rpx;
  color: #1e80ff;
  background: #e8f3ff;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  margin-top: 8rpx;
  font-weight: 500;
}

.action-btns {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.btn-edit,
.btn-delete {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 22rpx;
  font-size: 22rpx;
  border-radius: 6rpx;
  line-height: 1.3;
  white-space: nowrap;
}

.btn-edit {
  color: #1e80ff;
  background: #e8f3ff;
  border: 1rpx solid rgba(30, 128, 255, 0.2);
}

.btn-edit:active {
  background: #d6e8ff;
}

.btn-delete {
  color: #ff4d4f;
  background: #fff0f0;
  border: 1rpx solid rgba(255, 77, 79, 0.2);
}

.btn-delete:active {
  background: #ffe0e0;
}

.modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 999;
}

.modal-card {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 36rpx;
  width: 640rpx;
  max-height: 80vh;
  z-index: 1000;
}

.modal-scroll {
  max-height: 70vh;
  padding-right: 4rpx;
}

.modal-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.modal-btns .btn {
  flex: 1;
  width: auto;
}