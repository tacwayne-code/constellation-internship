.login-container {
  background: #ffffff;
  min-height: 100vh;
  padding: 0 48rpx 40rpx 48rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
}

.login-form-wrap {
  width: 100%;
  margin-top: -60rpx;
}

.login-brand {
  text-align: center;
}

.login-logo {
  width: 128rpx;
  height: 128rpx;
  background: linear-gradient(135deg, #1e80ff, #0052d9);
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 64rpx;
  margin: 0 auto 32rpx auto;
  box-shadow: 0 16rpx 40rpx rgba(30, 128, 255, 0.3);
}

.login-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #1d2129;
  margin-bottom: 12rpx;
}

.login-subtitle {
  font-size: 24rpx;
  color: #86909c;
}

.role-selector {
  display: flex;
  background: #f2f3f5;
  padding: 8rpx;
  border-radius: 20rpx;
  margin: 48rpx 0 40rpx 0;
}

.role-option {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #86909c;
  border-radius: 16rpx;
  transition: all 0.2s;
  font-weight: 500;
}

.role-option.active {
  background: #ffffff;
  color: #1e80ff;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.input-group {
  margin-bottom: 32rpx;
}

.input-label {
  display: block;
  font-size: 24rpx;
  color: #86909c;
  margin-bottom: 12rpx;
}

.input-box input {
  width: 100%;
  height: 84rpx;
  background: #f7f8fa;
  border: 1rpx solid #e5e6eb;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.input-box input:focus {
  border-color: #1e80ff;
  background: #ffffff;
}

.login-btn {
  width: 100%;
  height: 96rpx;
  background: #1e80ff;
  color: #ffffff;
  border: none;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  letter-spacing: 4rpx;
  box-shadow: 0 8rpx 24rpx rgba(30, 128, 255, 0.25);
}

.login-btn::after {
  border: none;
}

.login-footer {
  position: fixed;
  bottom: 60rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 22rpx;
  color: #86909c;
}
