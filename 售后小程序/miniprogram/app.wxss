page {
  background-color: #f4f5f7;
  font-size: 28rpx;
  color: #1d2129;
}

view, text, button, input {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1.5;
}

button::after {
  border: none;
}

.container {
  padding: 20rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #1d2129;
}

.form-group {
  margin-bottom: 20rpx;
  width: 100%;
}

.form-label {
  font-size: 26rpx;
  color: #86909c;
  margin-bottom: 10rpx;
  display: block;
}

.form-input,
.form-select,
.form-textarea {
  box-sizing: border-box;
  display: block;
  width: 100%;
  min-height: 80rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #e5e6eb;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #1d2129;
  background: #fafafa;
  line-height: 44rpx;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  resize: none;
  line-height: 44rpx;
}

.btn {
  width: 100%;
  padding: 22rpx 0;
  background: #1e80ff;
  color: #fff;
  border: none;
  border-radius: 10rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  line-height: 1.5;
}

.btn-success {
  background: #52c41a;
}

.btn-outline {
  background: #fff;
  color: #1e80ff;
  border: 1rpx solid #1e80ff;
}

.badge {
  padding: 4rpx 16rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
}

.badge-pending { background: #fff7e6; color: #faad14; }
.badge-processing { background: #e8f3ff; color: #1e80ff; }
.badge-done { background: #f6ffed; color: #52c41a; }

.info-row {
  display: flex;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.info-label {
  color: #86909c;
  width: 170rpx;
  flex-shrink: 0;
}

.info-val {
  color: #1d2129;
  flex: 1;
  min-width: 0;
  word-break: break-all;
  overflow-wrap: break-word;
}

.grid-3 {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-box {
  flex: 1;
  background: #fff;
  padding: 20rpx;
  border-radius: 16rpx;
  text-align: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #1e80ff;
}

.stat-desc {
  font-size: 22rpx;
  color: #86909c;
  margin-top: 4rpx;
}

.empty-tip {
  text-align: center;
  color: #86909c;
  padding: 60rpx 0;
  font-size: 28rpx;
}
