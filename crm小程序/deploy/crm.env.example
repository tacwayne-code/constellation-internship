# Keep this file on the server only. Run: chmod 600 crm.env
AMAP_WEB_SERVICE_KEY=replace_with_amap_web_service_key
AMAP_TIMEOUT_SECONDS=15

# Browser testing uses DEMO. Change to WECHAT only after HTTPS and the
# official mini-program configuration are ready.
CRM_AUTH_MODE=DEMO
CRM_EMPLOYEE_FILE=/home/sameng/apps/crm-v01/shared/employees.json
CRM_COOKIE_SECURE=1
CRM_DEMO_EMPLOYEE_ID=USR-00018
CRM_ALLOWED_ORIGINS=https://crm.example.com
WECHAT_APP_ID=replace_with_mini_program_appid
WECHAT_APP_SECRET=replace_with_server_side_appsecret
# 统一身份网关签发的短时单点登录票据验签密钥；仅服务器环境变量使用。
SSO_SHARED_SECRET=replace_with_shared_secret

# Use MOCK until the Odoo test account is ready.
CRM_ERP_MODE=MOCK
ODOO_BASE_URL=https://odoo.example.com
ODOO_DATABASE=replace_with_database
ODOO_USERNAME=replace_with_username
ODOO_PASSWORD=replace_with_password
ODOO_TIMEOUT_SECONDS=20

# V2 统一平台客户主数据桥。未配置时 CRM 仍只写本地 JSON。
PLATFORM_BASE_URL=http://platform:8011
PLATFORM_INTERNAL_SECRET=replace_with_same_platform_internal_secret
PLATFORM_TIMEOUT_SECONDS=12
