.launch {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 220rpx 56rpx 80rpx;
  text-align: center;
}
.brand {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 116rpx;
  height: 116rpx;
  margin: 0 auto 52rpx;
  border-radius: 16rpx;
  background: #2867a4;
  color: #fff;
  font-size: 36rpx;
  font-weight: 800;
}
.title { margin-bottom: 18rpx; font-size: 40rpx; font-weight: 700; }
.note { color: #66758a; font-size: 28rpx; line-height: 1.7; }
.error { color: #a23a34; }

.application-form {
  margin-top: 42rpx;
  text-align: left;
}

.field-label {
  margin: 24rpx 0 12rpx;
  color: #34495e;
  font-size: 26rpx;
  font-weight: 600;
}

.input,
.picker {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  padding: 0 26rpx;
  border: 1rpx solid #c9d4df;
  border-radius: 10rpx;
  background: #fff;
  font-size: 30rpx;
  line-height: 88rpx;
}

.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker text { color: #8190a0; font-size: 42rpx; }
.role-note { margin-top: 22rpx; }
.primary, .secondary {
  height: 92rpx;
  margin-top: 52rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 92rpx;
}
.primary { background: #2867a4; color: #fff; }
.secondary { border: 1rpx solid #c5d1dd; background: #fff; color: #253b53; }
.spinner {
  width: 48rpx;
  height: 48rpx;
  margin: 0 auto 32rpx;
  border: 6rpx solid #dce5ee;
  border-top-color: #2867a4;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
