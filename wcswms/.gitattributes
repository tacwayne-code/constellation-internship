* text=auto
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
# Preserve CRLF even in GitHub ZIP downloads, which use stored blob bytes.
*.cmd -text
*.ps1 text eol=crlf
*.glb binary
*.png binary
# The updater validates exact SHA-256 bytes from its release manifest.
release/wms-device-ip-update/** binary
