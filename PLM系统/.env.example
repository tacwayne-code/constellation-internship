# PLM 系统环境变量配置
# 复制此文件为 .env 并按需修改

# Flask 密钥（生产环境务必设置随机值）
# SECRET_KEY=your-random-secret-key-here

# 服务器绑定（默认仅本机）
# PLM_HOST=127.0.0.1
# PLM_PORT=5000

# 数据库自动初始化（数据库文件不存在时自动创建表）
# PLM_AUTO_INIT=1

# Odoo SSL 验证（仅内网自签证书环境设为 1）
# PLM_ODOO_INSECURE_SSL=1

# Session cookie HTTPS only（HTTPS 部署时设为 1）
# PLM_SECURE_COOKIE=1
