# ============================================================
# 紧急采购看板 - 配置模板（.env.example）
# 使用：复制本文件为 .env 并填写真实值，然后启动 启动.bat
# 注意：.env 包含账号密码，请勿提交到代码仓库 / 分享给他人
# ============================================================

# Odoo 地址（可填 http://x.inspiri.cn 或 https://xxx.odoo.com）
ODOO_URL=http://x.inspiri.cn

# Odoo 数据库名
ODOO_DB=inspiri_erp

# Odoo 登录账号（必填）
ODOO_USER=你的Odoo账号

# Odoo 登录密码（必填）
ODOO_PASSWORD=你的Odoo密码

# ---- 以下为可选高级配置，需要时取消注释修改 ----

# 紧急标记字段名（可选）：默认自动探测 x_studio_urgent / x_urgent / urgent / x_studio_is_urgent / x_studio_priority / priority
# ODOO_URGENT_FIELD=x_studio_urgent

# 紧急标签文本（字段为文本/选择型时按此匹配）
# ODOO_URGENT_TAG=紧急

# 完整紧急过滤域(JSON)，配置后优先于字段探测，例如：
# ODOO_URGENT_DOMAIN=[["x_studio_urgent","=",true]]

# 未采购状态（JSON 数组）
# ODOO_URGENT_STATES=["draft","sent","to approve"]

# 板块分类规则（可选）：按「清单名关键词」自动归类采购清单到板块，JSON 对象 {板块名: [关键词...]}
# 不配置时使用内置默认：立体仓储 / RGV / 堆垛机（未命中归「其他」）
# 示例：ODOO_LIST_CATEGORIES={"立体仓储":["立体仓储","立体库"],"RGV":["rgv"],"堆垛机":["堆垛机","stacker"]}

# 服务端口（默认 8766）
# PORT=8766

# 服务监听地址（默认 127.0.0.1 仅本机；如需局域网共享改为 0.0.0.0）
# HOST=127.0.0.1

# 前端「在 Odoo 打开」跳转用的 Odoo 地址（默认回退到 ODOO_URL）
# 建议显式配置为浏览器可访问的 Odoo 地址，避免误用 127.0.0.1 等本机回环地址
# ODOO_WEB_URL=http://192.168.1.100:8018

# 访问令牌（可选）：设置后 /api/* 请求必须携带 ?token=<此值> 或 Authorization: Bearer <此值>
# 建议在 HOST=0.0.0.0（局域网共享）时启用，防止内网任意设备读取看板数据
# BOARD_ACCESS_TOKEN=请设置一段随机字符串

# 数据缓存秒数（默认 180）
# CACHE_TTL_SECONDS=180
