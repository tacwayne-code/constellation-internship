DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
MYSQL_DATABASE=production_reporting_admin
MYSQL_USER=production_reporting
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
INTERNAL_REPORT_API_KEY=replace-with-a-long-internal-api-key
# SOP host is environment-specific. Point each URL at your deployment's host
# and port instead of relying on a hard-coded internal IP.
SOP_REPORTS_API_URL=http://<SOP_HOST>:8093/api/reports
SOP_WORKORDERS_API_URL=http://<SOP_HOST>:8093/api/workorders
SOP_ORDER_SUMMARY_API_URL=http://<SOP_HOST>:8093/api/order-summary
SOP_WORKERS_API_URL=http://<SOP_HOST>:8093/api/workers
SOP_EMPLOYEE_SYNC_URL=http://<SOP_HOST>:8093/api/workers/sync
