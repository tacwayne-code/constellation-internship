<view class="home-page">
  <view class="greeting">
    <view class="greeting-name">{{user.name}}，{{greeting}}</view>
    <view class="greeting-sub">欢迎使用企业服务工作台</view>
  </view>

  <view class="module-list">
    <button wx:if="{{hasCrm}}" class="module-card crm-card" bindtap="openCrm">
      <view class="module-icon crm-icon"><view class="person-symbol"></view></view>
      <view class="module-copy"><view class="module-title">销售 CRM</view><view class="module-desc">客户管理、商机跟进、拜访记录，助力销售全流程管理</view></view>
      <view class="module-arrow">›</view>
    </button>

    <button wx:if="{{hasService}}" class="module-card service-card" bindtap="openService">
      <view class="module-icon service-icon"><view class="headset-symbol">◔</view></view>
      <view class="module-copy"><view class="module-title">ASS 售后服务</view><view class="module-desc">工单派发、工程师处理、服务进度跟踪；数量以 ASS 实时数据为准</view></view>
      <view class="module-arrow">›</view>
    </button>
  </view>

  <view class="role-panel">
    <view class="role-title">我的权限</view>
    <view wx:for="{{roles}}" wx:key="key" class="role-row">
      <view class="role-icon {{item.tone}}">{{item.abbr}}</view>
      <view class="role-copy"><view>{{item.name}}</view><text>{{item.description}}</text></view>
      <view class="arrow muted-arrow">›</view>
    </view>
  </view>
</view>
