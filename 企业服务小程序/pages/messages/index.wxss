.message-page { padding: 46rpx 30rpx; }.page-title { color: #172B4D; font-size: 48rpx; font-weight: 700; }.page-subtitle { margin-top: 14rpx; color: #7A8494; font-size: 27rpx; }.notice-list { margin-top: 36rpx; overflow: hidden; border-radius: 20rpx; background: #fff; }.notice-row { min-height: 130rpx; display: flex; align-items: flex-start; padding: 30rpx 26rpx; border-bottom: 1rpx solid #E9EDF2; }.notice-row:last-child { border-bottom: 0; }.notice-dot { width: 14rpx; height: 14rpx; flex: 0 0 auto; margin-top: 12rpx; border-radius: 50%; background: #F28C3A; }.notice-copy { flex: 1; padding-left: 18rpx; color: #172B4D; font-size: 29rpx; font-weight: 650; }.notice-copy text { display: block; margin-top: 10rpx; color: #7A8494; font-size: 24rpx; font-weight: 400; line-height: 34rpx; }.notice-time { padding-left: 14rpx; color: #98A2B3; font-size: 22rpx; }
.message-empty { margin-top: 36rpx; padding: 86rpx 36rpx; border-radius: 20rpx; background: #fff; text-align: center; box-shadow: 0 10rpx 30rpx rgba(23,43,77,.05); }
.message-empty-icon { width: 84rpx; height: 84rpx; margin: 0 auto; border-radius: 42rpx; background: #EAF3FF; color: #2878F0; font-size: 44rpx; line-height: 84rpx; }
.message-empty-title { margin-top: 28rpx; color: #172B4D; font-size: 32rpx; font-weight: 700; }
.message-empty-copy { margin-top: 12rpx; color: #7A8494; font-size: 24rpx; }
