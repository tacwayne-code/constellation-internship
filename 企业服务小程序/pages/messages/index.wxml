<view class="message-page">
  <view class="page-title">消息</view>
  <view class="page-subtitle">系统提醒与业务待办会在这里汇总</view>
  <view class="notice-list">
    <view wx:for="{{notices}}" wx:key="title" class="notice-row">
      <view class="notice-dot"></view>
      <view class="notice-copy"><view>{{item.title}}</view><text>{{item.body}}</text></view>
      <view class="notice-time">{{item.time}}</view>
    </view>
  </view>
  <view wx:if="{{!notices.length}}" class="message-empty">
    <view class="message-empty-icon">✓</view>
    <view class="message-empty-title">暂无新消息</view>
    <view class="message-empty-copy">这里只显示服务端产生的真实业务提醒</view>
  </view>
</view>
