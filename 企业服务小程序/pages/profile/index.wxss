.profile-page { padding: 46rpx 30rpx; }.profile-head { display: flex; align-items: center; }.avatar { width: 104rpx; height: 104rpx; display: grid; place-items: center; margin-right: 24rpx; border-radius: 30rpx; background: #172B4D; color: #fff; font-size: 46rpx; font-weight: 700; }.profile-name { color: #172B4D; font-size: 42rpx; font-weight: 700; }.profile-id { margin-top: 10rpx; color: #7A8494; font-size: 24rpx; }.profile-card { margin-top: 28rpx; padding: 28rpx; border-radius: 20rpx; background: #fff; }.profile-label { padding-bottom: 18rpx; border-bottom: 1rpx solid #E9EDF2; color: #172B4D; font-size: 30rpx; font-weight: 700; }.role-line { padding: 23rpx 0; border-bottom: 1rpx solid #E9EDF2; color: #475467; font-size: 27rpx; }.role-line:last-child { border-bottom: 0; }.logout-button { width: 100%; height: 90rpx; margin-top: 38rpx; border: 1rpx solid #D8DEE8; border-radius: 16rpx; background: #fff; color: #C33F32; font-size: 28rpx; line-height: 90rpx; }
