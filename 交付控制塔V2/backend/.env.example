# ---- Odoo ----
ODOO_URL=http://192.168.1.100:8018
ODOO_DB=inspiri_erp_test
ODOO_USER=admin
ODOO_PASSWORD=your_password_here
SESSION_TTL=1800

# ---- Mock 降级（true=强制离线演示模式）----
USE_MOCK=false
MOCK_DATA_DIR=mock_data

# ---- PLM 适配器（mock / rest）----
PLM_ADAPTER=mock
PLM_URL=
PLM_API_KEY=
PLM_MODEL=

# ---- 缓存 ----
CACHE_TTL_DEFAULT=60
REDIS_URL=

# ---- Web ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
