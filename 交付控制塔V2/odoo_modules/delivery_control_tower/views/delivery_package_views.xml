<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 交付包列表 -->
    <record id="view_delivery_package_tree" model="ir.ui.view">
        <field name="name">project.delivery.package.tree</field>
        <field name="model">project.delivery.package</field>
        <field name="arch" type="xml">
            <tree string="交付包" editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="owner_id"/>
                <field name="phase"/>
                <field name="due_date"/>
                <field name="status"/>
                <field name="progress" widget="progressbar"/>
            </tree>
        </field>
    </record>

    <!-- 交付包表单 -->
    <record id="view_delivery_package_form" model="ir.ui.view">
        <field name="name">project.delivery.package.form</field>
        <field name="model">project.delivery.package</field>
        <field name="arch" type="xml">
            <form string="交付包">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="交付包名称"/>
                        </h1>
                        <group>
                            <field name="code"/>
                        </group>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="owner_id"/>
                            <field name="phase"/>
                        </group>
                        <group>
                            <field name="due_date"/>
                            <field name="status"/>
                            <field name="status_label"/>
                            <field name="progress" widget="progressbar"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- 交付包看板 -->
    <record id="view_delivery_package_kanban" model="ir.ui.view">
        <field name="name">project.delivery.package.kanban</field>
        <field name="model">project.delivery.package</field>
        <field name="arch" type="xml">
            <kanban string="交付包" default_group_by="phase">
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_title">
                                <field name="code"/> · <field name="name"/>
                            </div>
                            <div class="o_kanban_record_subtitle">
                                <field name="project_id"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <field name="owner_id"/>
                                <field name="due_date"/>
                                <field name="status"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- 交付包搜索 -->
    <record id="view_delivery_package_search" model="ir.ui.view">
        <field name="name">project.delivery.package.search</field>
        <field name="model">project.delivery.package</field>
        <field name="arch" type="xml">
            <search string="交付包">
                <field name="name"/>
                <field name="project_id"/>
                <filter name="risk" string="交期风险" domain="[('status', '=', 'risk')]"/>
                <filter name="watch" string="需关注" domain="[('status', '=', 'watch')]"/>
                <group expand="0" string="分组">
                    <filter name="by_project" string="项目" context="{'group_by': 'project_id'}"/>
                    <filter name="by_phase" string="阶段" context="{'group_by': 'phase'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
