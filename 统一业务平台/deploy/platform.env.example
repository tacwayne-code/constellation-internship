# 生产环境保存至 /opt/constellation/secrets/platform.env 并设置 chmod 600。
PLATFORM_DATABASE_URL=postgresql+psycopg://constellation:replace_me@postgres:5432/constellation
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace_with_generated_pbkdf2_hash
ADMIN_SESSION_SECRET=replace_with_64_char_random_secret
COOKIE_SECURE=1

# 迁移期只读挂载旧数据；完成切流后可以删除这些变量。
LEGACY_IDENTITY_DB=/data/legacy/identity.db
LEGACY_CRM_JSON=/data/legacy/shared-db.json
LEGACY_ASS_DB=/data/legacy/aftersales.db

WECHAT_APP_ID=replace_with_app_id
WECHAT_APP_SECRET=replace_with_app_secret
SSO_SHARED_SECRET=replace_with_existing_shared_secret

# Odoo 使用专用接口账号/API Key；登录名必须填写 Odoo 中的完整登录名。
ODOO_BASE_URL=https://odoo.example.com
ODOO_DATABASE=replace_with_database
ODOO_USERNAME=api_user@example.com
ODOO_API_KEY=replace_with_api_key
ODOO_TIMEOUT_SECONDS=20
ODOO_WRITE_ENABLED=0

# CRM 容器调用统一平台的内部凭据，另行生成，不复用管理员或微信密钥。
PLATFORM_INTERNAL_SECRET=replace_with_64_char_random_secret
